<com.example.tuno.fragments.TracksFragment xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/tracks_fragment_holder"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:id="@+id/tracks_heading" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingHorizontal="24dp" android:minHeight="48dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/tracks_count" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textColor="@color/tuno_muted" android:textSize="13sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/shuffle_tracks"
            style="@style/TunoCategoryButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/tuno_shuffle" app:icon="@drawable/ic_shuffle_vector" />
    </LinearLayout>
    <com.qtalk.recyclerviewfastscroller.RecyclerViewFastScroller android:id="@+id/tracks_fastscroller"
        android:layout_width="match_parent" android:layout_height="match_parent" android:layout_below="@id/tracks_heading">
        <org.fossify.commons.views.MyRecyclerView android:id="@+id/tracks_list"
            android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false"
            android:paddingHorizontal="16dp" android:paddingBottom="16dp"
            android:layoutAnimation="@anim/layout_animation" app:layoutManager="org.fossify.commons.views.MyLinearLayoutManager" />
    </com.qtalk.recyclerviewfastscroller.RecyclerViewFastScroller>
    <ScrollView android:id="@+id/tracks_empty" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_below="@id/tracks_heading" android:fillViewport="true" android:clipToPadding="false"
        android:paddingHorizontal="24dp" android:paddingTop="16dp" android:paddingBottom="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center" android:padding="24dp" android:background="@drawable/tuno_card">
            <ImageView android:id="@+id/tracks_empty_art" android:layout_width="120dp" android:layout_height="120dp" android:src="@drawable/tuno_record"
                android:importantForAccessibility="no" />
            <TextView android:id="@+id/tracks_placeholder" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:gravity="center" android:text="@string/tuno_empty_music"
                android:textColor="@color/tuno_ink" android:textSize="22sp" android:fontFamily="sans-serif-medium" />
            <TextView android:id="@+id/tracks_empty_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:gravity="center" android:lineSpacingExtra="4dp"
                android:text="@string/tuno_empty_music_hint" android:textColor="@color/tuno_muted" android:textSize="14sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/scan_tracks"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp"
                android:minHeight="52dp" android:text="@string/tuno_scan" android:textAllCaps="false"
                android:textColor="@color/tuno_surface" app:backgroundTint="@color/tuno_accent" app:cornerRadius="26dp" />
        </LinearLayout>
    </ScrollView>
</com.example.tuno.fragments.TracksFragment>
