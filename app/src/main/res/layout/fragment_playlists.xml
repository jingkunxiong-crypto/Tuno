<com.example.tuno.fragments.PlaylistsFragment xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/playlists_fragment_holder"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <com.qtalk.recyclerviewfastscroller.RecyclerViewFastScroller android:id="@+id/playlists_fastscroller"
        android:layout_width="match_parent" android:layout_height="match_parent">
        <org.fossify.commons.views.MyRecyclerView android:id="@+id/playlists_list"
            android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false"
            android:paddingBottom="16dp" android:layoutAnimation="@anim/layout_animation"
            app:layoutManager="org.fossify.commons.views.MyLinearLayoutManager" />
    </com.qtalk.recyclerviewfastscroller.RecyclerViewFastScroller>
    <ScrollView android:id="@+id/playlists_empty" android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:padding="24dp" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center" android:padding="24dp" android:background="@drawable/tuno_card">
            <ImageView android:id="@+id/playlists_empty_art" android:layout_width="112dp" android:layout_height="112dp" android:src="@drawable/tuno_record"
                android:importantForAccessibility="no" />
            <TextView android:id="@+id/playlists_placeholder" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:gravity="center" android:text="@string/tuno_empty_playlists"
                android:textColor="@color/tuno_ink" android:textSize="22sp" android:fontFamily="sans-serif-medium" />
            <TextView android:id="@+id/playlists_empty_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:gravity="center" android:lineSpacingExtra="4dp"
                android:text="@string/tuno_empty_playlists_hint" android:textColor="@color/tuno_muted" android:textSize="14sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/playlists_placeholder_2"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp"
                android:minHeight="52dp" android:text="@string/tuno_new_playlist" android:textAllCaps="false"
                android:textColor="@color/tuno_surface" app:backgroundTint="@color/tuno_accent" app:cornerRadius="26dp" />
        </LinearLayout>
    </ScrollView>
</com.example.tuno.fragments.PlaylistsFragment>
