<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/tuno_background">
    <org.fossify.commons.views.MyAppBarLayout android:id="@+id/library_appbar" android:layout_width="match_parent" android:layout_height="wrap_content">
        <com.google.android.material.appbar.MaterialToolbar android:id="@+id/library_toolbar"
            android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" android:layout_marginHorizontal="16dp" android:layout_marginBottom="12dp"
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />
    </org.fossify.commons.views.MyAppBarLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <FrameLayout android:id="@+id/library_content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <include android:id="@+id/current_track_bar" layout="@layout/view_current_track_bar"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="12dp" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
