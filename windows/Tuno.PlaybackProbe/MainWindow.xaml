      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Grid.RowSpan="2" Grid.Column="0" Background="#74242F39" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" CornerRadius="24" Padding="16,22,16,16">
       <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="8,0,0,26"><TextBlock Text="T U N O" Foreground="{StaticResource Muted}" FontSize="13"/><TextBlock Text="音色工作台" FontFamily="Microsoft YaHei UI" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,6"/><TextBlock Text="实时调整当前播放" Foreground="{StaticResource Muted}" FontSize="14"/></StackPanel>
        <StackPanel Grid.Row="1"><TextBlock Text="页面" Foreground="{StaticResource Muted}" FontSize="13" Margin="10,0,0,10"/><Button Content="⚙  设置" Click="OpenSettings" Style="{StaticResource SidebarButton}"/><Button Content="〽  均衡器" Style="{StaticResource SidebarButton}" Background="#604F7882"/></StackPanel>
        <Button Grid.Row="2" Content="←  返回音乐库" Click="CloseEqualizer" Style="{StaticResource SidebarButton}" Margin="0"/>
       </Grid>
      </Border>
      <DockPanel Grid.Column="2" Margin="0,6,0,20"><TextBlock Text="均衡器" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="独立的声音调校页面" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="18,0,0,0"/></DockPanel>
      <Grid Grid.Row="1" Grid.Column="2">
       <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Background="{StaticResource GlassPanel}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" CornerRadius="22" Padding="22" VerticalAlignment="Top">
        <StackPanel>
         <TextBlock Text="音色工作台" FontSize="22" FontWeight="SemiBold"/>
         <TextBlock Text="对当前播放和后续歌曲实时生效" Foreground="{StaticResource Muted}" FontSize="14" TextWrapping="Wrap" Margin="0,7,0,24"/>
         <CheckBox x:Name="EqualizerEnabledCheck" Content="启用均衡器" Checked="EqualizerEnabledChanged" Unchecked="EqualizerEnabledChanged" Margin="0,0,0,22"/>
         <TextBlock Text="音色预设" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
         <ComboBox x:Name="EqualizerPresetBox" HorizontalAlignment="Stretch" SelectionChanged="EqualizerPresetChanged"/>
         <TextBlock x:Name="EqualizerSummary" Text="关闭" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,22,0,0"/>
        </StackPanel>
       </Border>
       <Border Grid.Column="2" Background="{StaticResource GlassPanel}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" CornerRadius="22" Padding="22">
        <Grid>
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <DockPanel Margin="0,0,0,18"><TextBlock Text="频段" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="-12 dB  至  +12 dB" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
         <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <UniformGrid x:Name="EqualizerBands" Rows="1" MinWidth="560" VerticalAlignment="Stretch"/>
         </ScrollViewer>
         <TextBlock Grid.Row="2" Text="选择“自定义”后可拖动各频段；调整会立即应用。" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,16,0,0"/>
        </Grid>
       </Border>
      </Grid>
     </Grid>
     <Grid x:Name="FullscreenLyricsPanel" Visibility="Collapsed" Margin="28,24,28,18">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,12"><Button Content="←  返回播放页" Click="CloseFullscreenLyrics"/><StackPanel Margin="14,0,0,0"><TextBlock x:Name="FullscreenSongTitle" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="FullscreenSongArtist" Foreground="{StaticResource Muted}" FontSize="14"/></StackPanel><Button Content="导入 LRC" Click="ImportLyrics" HorizontalAlignment="Right"/></DockPanel>
     <ListBox x:Name="FullscreenLyricList" Grid.Row="1" ItemContainerStyle="{StaticResource LyricItem}" SelectionChanged="LyricSelectionChanged" PreviewMouseWheel="LyricsUserScroll" PreviewMouseLeftButtonDown="LyricsPointerDown" SizeChanged="LyricListSizeChanged" ScrollViewer.CanContentScroll="False" VirtualizingPanel.IsVirtualizing="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="20,0">
      <ListBox.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource LyricScrollBar}"/></ListBox.Resources>
      <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" TextWrapping="Wrap" TextAlignment="Center" FontFamily="Microsoft YaHei UI"/></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <TextBlock x:Name="FullscreenLyricsPlaceholder" Grid.Row="1" Text="选择一首带歌词的歌曲，或点击「导入 LRC」添加歌词。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
     <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0"><Button Content="回到当前句" Click="FollowLyrics"/><Button Content="播放 / 暂停" Click="Toggle" Style="{StaticResource PrimaryButton}"/><Button Content="队列" Click="OpenQueue" Margin="0"/></StackPanel>
    </Grid>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="{StaticResource GlassDock}" BorderBrush="#36FFFFFF" BorderThickness="0,1,0,0" Padding="20,10">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="12"/><ColumnDefinition Width="190"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="285"/></Grid.ColumnDefinitions>
    <Border Background="#34424D" Width="56" Height="56" CornerRadius="12" ClipToBounds="True" VerticalAlignment="Center"><Image x:Name="Artwork" Stretch="UniformToFill" SizeChanged="ArtworkSizeChanged"/></Border>
    <Button Grid.Column="2" Click="OpenNowPlaying" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="0" ToolTip="打开播放页">
     <StackPanel><TextBlock x:Name="Status" Text="选择一首歌曲" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="184"/><TextBlock x:Name="MiniState" Text="点击查看封面与歌词" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0"/></StackPanel>
    </Button>
    <Grid Grid.Column="4" VerticalAlignment="Center">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,3">
      <TextBlock x:Name="TimeLabel" DockPanel.Dock="Right" Text="00:00 / 00:00" Foreground="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13"/>
      <Slider x:Name="Seek" Minimum="0" Maximum="1" Visibility="Collapsed" IsMoveToPointEnabled="True" PreviewMouseLeftButtonDown="BeginSeek" PreviewMouseLeftButtonUp="EndSeek" PreviewKeyUp="KeySeek" LostMouseCapture="SeekLostCapture" AutomationProperties.Name="播放进度"/>
      <local:WaveformProgress x:Name="MiniWaveform" Height="28" Cursor="Hand" ToolTip="点击跳转播放进度"/>
     </DockPanel>
     <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
      <Button Content="◀◀" Click="Previous" ToolTip="上一首" Padding="15,7"/>
      <Button x:Name="MiniPlayButton" Content="播放" ContentTemplate="{StaticResource PlayPauseIconTemplate}" Click="Toggle" Style="{StaticResource PrimaryButton}" ToolTip="播放或暂停" Padding="19,7" FontSize="21"/>
      <Button Content="▶▶" Click="Next" ToolTip="下一首" Padding="15,7" Margin="0"/>
     </StackPanel>
    </Grid>
    <Grid Grid.Column="6" VerticalAlignment="Center">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,8"><TextBlock Text="音量" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/><Slider x:Name="Volume" Minimum="0" Maximum="100" Value="35" ValueChanged="VolumeChanged" VerticalAlignment="Center" AutomationProperties.Name="音量" Style="{StaticResource RoundedRailSlider}"/></DockPanel>
     <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="ShuffleButton" Content="随机：关" Click="ToggleShuffle" Padding="11,8" FontSize="14"/>
      <Button x:Name="PlaybackModeButton" Content="顺序播放" Click="TogglePlaybackMode" ToolTip="点击切换播放模式" Padding="11,8" FontSize="14"/>
      <Button x:Name="SpeedButton" Content="1.0×  ▴" Click="ToggleSpeedPanel" ToolTip="调节播放速度" Padding="11,8" FontSize="14" Margin="0"/>
     </StackPanel>
     <Popup x:Name="SpeedPopup" PlacementTarget="{Binding ElementName=SpeedButton}" Placement="Top" HorizontalOffset="-282" VerticalOffset="-10" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
      <Border Width="356" Background="#F02A3741" BorderBrush="#7AA6B8C0" BorderThickness="1" CornerRadius="20" Padding="20,17">
       <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="6" Opacity="0.42"/></Border.Effect>
       <StackPanel>
        <DockPanel Margin="0,0,0,12"><TextBlock Text="播放速度" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="SpeedValue" Text="1.0×" DockPanel.Dock="Right" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource Accent}" HorizontalAlignment="Right"/></DockPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
         <Button Content="−" Click="DecreaseSpeed" Padding="0" Width="30" Height="30" FontSize="20" ToolTip="减慢 0.05 倍"/>
         <Grid Grid.Column="1" Margin="8,0"><Slider x:Name="SpeedSlider" Minimum="0" Maximum="324" Value="162" ValueChanged="SpeedSliderChanged" AutomationProperties.Name="播放速度" Style="{StaticResource RoundedRailSlider}"/>
          <Ellipse Width="5" Height="5" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
         </Grid>
         <Button Grid.Column="2" Content="＋" Click="IncreaseSpeed" Padding="0" Width="30" Height="30" FontSize="18" ToolTip="加快 0.05 倍" Margin="0"/>
        </Grid>
        <Grid Margin="42,5,42,0"><TextBlock Text="0.25×" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Left"/><Button Content="1.0×" Click="ResetSpeed" Foreground="{StaticResource Accent}" Background="Transparent" BorderThickness="0" Padding="5,0" FontSize="12" HorizontalAlignment="Center" Margin="0" ToolTip="恢复正常速度"/><TextBlock Text="3.0×" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Right"/></Grid>
       </StackPanel>
      </Border>
     </Popup>
    </Grid>
   </Grid>
  </Border>
 </Grid>
</Window>

